{
  "name": "webtense-blog-daily",
  "active": false,
  "notes": "IMPORTAR EN N8N: Subir este archivo en n8n.webtenseenergy.com → Workflows → Import. Configurar credenciales HTTP Header Auth con CRON_SECRET (variable de entorno del servidor).",
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Madrid"
  },
  "meta": {
    "description": "Genera automáticamente 1 artículo de blog B2B al día. Llama a /api/automation/blog/propose (GET) para obtener un tema único, luego a /api/automation/blog/create (POST) para generar y guardar el draft. Notifica por Telegram si está configurado."
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "schedule-daily-blog",
      "name": "Todos los días a las 9:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.APP_BASE_URL }}/api/automation/blog/propose",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "id": "http-propose",
      "name": "Obtener tema del día",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "webtense-cron-secret",
          "name": "webtense-cron-secret"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_BASE_URL }}/api/automation/blog/create",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"topic\": \"{{ $json.body.topic }}\",\n  \"locale\": \"es\"\n}",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "id": "http-create",
      "name": "Generar artículo con IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "webtense-cron-secret",
          "name": "webtense-cron-secret"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-status",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-success",
      "name": "¿Éxito?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=✅ *Webtense Energy — Nuevo draft de blog generado*\n\n📝 *Título:* {{ $node[\"Generar artículo con IA\"].json.body.post.title }}\n🔗 Revisar en: https://webtenseenergy.com/admin/posts",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-success",
      "name": "Notificar éxito (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1200, 200],
      "credentials": {
        "telegramApi": {
          "id": "telegram-bot-webtense",
          "name": "telegram-bot-webtense"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=❌ *Webtense Energy — Error generando blog*\n\nStatusCode: {{ $json.statusCode }}\nError: {{ $json.body.error || \"Sin detalle\" }}\n\nRevisar logs en el servidor.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-error",
      "name": "Notificar error (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1200, 400],
      "credentials": {
        "telegramApi": {
          "id": "telegram-bot-webtense",
          "name": "telegram-bot-webtense"
        }
      }
    }
  ],
  "connections": {
    "Todos los días a las 9:00": {
      "main": [
        [{ "node": "Obtener tema del día", "type": "main", "index": 0 }]
      ]
    },
    "Obtener tema del día": {
      "main": [
        [{ "node": "Generar artículo con IA", "type": "main", "index": 0 }]
      ]
    },
    "Generar artículo con IA": {
      "main": [
        [{ "node": "¿Éxito?", "type": "main", "index": 0 }]
      ]
    },
    "¿Éxito?": {
      "main": [
        [{ "node": "Notificar éxito (Telegram)", "type": "main", "index": 0 }],
        [{ "node": "Notificar error (Telegram)", "type": "main", "index": 0 }]
      ]
    }
  }
}
