# --------------------------------------------------
# Aplicacion
# --------------------------------------------------

NODE_ENV="development"
APP_ENV="local"
PORT="3010"
NEXT_PUBLIC_SITE_URL="https://webtenseenergy.com"
APP_BASE_URL="https://webtenseenergy.com"
LOG_LEVEL="info"

# --------------------------------------------------
# Base de datos
# --------------------------------------------------

# Formato: postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
DATABASE_URL="postgresql://webtense:change_me@localhost:5432/webtenseenergy?schema=public"

# --------------------------------------------------
# Auth admin
# --------------------------------------------------

ADMIN_SESSION_SECRET="change_me"
ADMIN_SESSION_COOKIE_NAME="wte_admin_session"
ADMIN_EMAIL="admin@webtenseenergy.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change_me"

# --------------------------------------------------
# Email / SMTP
# --------------------------------------------------

SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="user@example.com"
SMTP_PASS="change_me"
EMAIL_FROM="info@webtenseenergy.com"

# --------------------------------------------------
# Publico controlado
# --------------------------------------------------

NEXT_PUBLIC_WHATSAPP="34600000000"
NEXT_IMAGE_HOSTS="webtenseenergy.com,images.unsplash.com"

# --------------------------------------------------
# Blog / IA / contenidos
# --------------------------------------------------

OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/auto"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_TIMEOUT_MS="15000"

# --------------------------------------------------
# Energia
# --------------------------------------------------

ESIOS_TOKEN=""

# --------------------------------------------------
# Telegram / ofertas
# --------------------------------------------------

TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_ID=""
TELEGRAM_WEBHOOK_SECRET=""
AMAZON_AFFILIATE_TAG="semillasdet02-21"

# --------------------------------------------------
# Newsletter / campanas
# --------------------------------------------------

NEWSLETTER_SENDER_NAME="Webtense Energy"
NEWSLETTER_REPLY_TO="info@webtenseenergy.com"

# --------------------------------------------------
# Jobs / endpoints internos
# --------------------------------------------------

CRON_SECRET="change_me"
