generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
  EDITOR
}

enum Locale {
  ES
  CA
}

enum PostStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum LeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  WON
  LOST
  SPAM
}

enum StudyStatus {
  NEW
  REVIEWING
  QUOTED
  WON
  LOST
}

enum ScheduleType {
  DAILY
  WEEKLY
  MONTHLY
  ONCE
}

enum SubscriberType {
  PARTICULAR
  EMPRESA
  INSTALADOR
}

model AdminUser {
  id          String        @id @default(cuid())
  email       String        @unique
  username    String        @unique
  password    String
  role        AdminRole     @default(EDITOR)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  posts       Post[]
  campaigns   Campaign[]
  telegramLog TelegramLog[]
  leadNotes   LeadNote[]
  auditLogs   AuditLog[]
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  locale      Locale?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  locale      Locale         @default(ES)
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  postLinks   PostCategory[]
}

model Tag {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  postLinks PostTag[]
}

model Post {
  id             String            @id @default(cuid())
  slug           String            @unique
  status         PostStatus        @default(DRAFT)
  publishedAt    DateTime?
  scheduledFor   DateTime?
  featuredImage  String?
  seoTitle       String?
  seoDescription String?
  locale         Locale            @default(ES)
  authorId       String?
  author         AdminUser?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  translations   PostTranslation[]
  categories     PostCategory[]
  tags           PostTag[]

  @@index([status, publishedAt])
  @@index([locale])
}

model PostTranslation {
  id        String   @id @default(cuid())
  postId    String
  locale    Locale
  title     String
  excerpt   String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
}

model PostCategory {
  postId     String
  categoryId String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Offer {
  id        String   @id @default(cuid())
  title     String
  price     String
  oldPrice  String?
  category  String
  discount  String?
  url       String
  icon      String?
  locale    Locale   @default(ES)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id          String     @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String?
  message     String
  source      String     @default("contacto")
  status      LeadStatus @default(NEW)
  locale      Locale     @default(ES)
  originPath  String?
  ipHash      String?
  userAgent   String?
  contactedAt DateTime?
  wonAt       DateTime?
  lostAt      DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  notes       LeadNote[]

  @@index([status, createdAt])
  @@index([email])
}

model StudyRequest {
  id            String      @id @default(cuid())
  method        String
  fileName      String?
  fileMimeType  String?
  fileSizeBytes Int?
  kwConsumed    String?
  habits        String      @default("[]")
  name          String
  email         String
  phone         String?
  company       String?
  source        String      @default("estudio")
  status        StudyStatus @default(NEW)
  locale        Locale      @default(ES)
  originPath    String?
  ipHash        String?
  userAgent     String?
  reviewedAt    DateTime?
  quotedAt      DateTime?
  wonAt         DateTime?
  lostAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model EmailLog {
  id                String    @id @default(cuid())
  channel           String
  destination       String
  subject           String
  status            String
  entityType        String?
  entityId          String?
  providerMessageId String?
  error             String?
  payload           String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([status, createdAt])
}

model Subscriber {
  id             String          @id @default(cuid())
  email          String          @unique
  fullName       String?
  locale         Locale          @default(ES)
  isActive       Boolean         @default(true)
  source         String          @default("web")
  subscriberType SubscriberType?
  consentedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  consents       Consent[]
  events         SendEvent[]
}

model Consent {
  id           String     @id @default(cuid())
  subscriberId String
  legalText    String
  ipAddress    String?
  userAgent    String?
  acceptedAt   DateTime   @default(now())
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
}

model Campaign {
  id           String          @id @default(cuid())
  name         String
  locale       Locale          @default(ES)
  subject      String
  preheader    String?
  status       CampaignStatus  @default(DRAFT)
  scheduleType ScheduleType?
  scheduledFor DateTime?
  sentAt       DateTime?
  authorId     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  author       AdminUser?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  blocks       CampaignBlock[]
  jobs         SendJob[]
}

model CampaignBlock {
  id         String   @id @default(cuid())
  campaignId String
  sortOrder  Int      @default(0)
  type       String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model SendJob {
  id         String      @id @default(cuid())
  campaignId String
  status     String      @default("pending")
  runAt      DateTime    @default(now())
  finishedAt DateTime?
  error      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  events     SendEvent[]

  @@index([status, runAt])
}

model SendEvent {
  id           String     @id @default(cuid())
  sendJobId    String
  subscriberId String
  eventType    String
  createdAt    DateTime   @default(now())
  sendJob      SendJob    @relation(fields: [sendJobId], references: [id], onDelete: Cascade)
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([eventType, createdAt])
}

model TelegramConfig {
  id            String   @id @default(cuid())
  botName       String?
  channelId     String
  webhookUrl    String?
  webhookSecret String?
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TelegramDeal {
  id        String    @id @default(cuid())
  offerId   String?
  title     String
  message   String
  url       String?
  status    String    @default("pending")
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model TelegramLog {
  id          String     @id @default(cuid())
  adminUserId String?
  action      String
  status      String
  detail      String?
  createdAt   DateTime   @default(now())
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
}

model LeadNote {
  id          String     @id @default(cuid())
  leadId      String
  adminUserId String?
  body        String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  lead        Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

model AuditLog {
  id          String     @id @default(cuid())
  adminUserId String?
  action      String
  entityType  String
  entityId    String?
  status      String
  ipHash      String?
  userAgent   String?
  metadata    String?
  createdAt   DateTime   @default(now())
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

model EnergyPriceSnapshot {
  id           String   @id @default(cuid())
  snapshotDate DateTime
  hour         Int
  price        Float
  source       String
  capturedAt   DateTime @default(now())
  rawPayload   String?

  @@unique([snapshotDate, hour])
  @@index([snapshotDate])
}

model EnergyDailySummary {
  id           String   @id @default(cuid())
  summaryDate  DateTime @unique
  minPrice     Float
  minHour      Int
  maxPrice     Float
  maxHour      Int
  avgPrice     Float
  currentPrice Float?
  entriesCount Int      @default(24)
  source       String
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@index([summaryDate])
}

model RateLimit {
  id         String   @id @default(cuid())
  identifier String
  endpoint   String
  count      Int      @default(1)
  resetAt    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, endpoint])
  @@index([resetAt])
}
