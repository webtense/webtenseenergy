{
  "$schema": "https://easypanel.io/schema.json",
  "name": "webtense-energy",
  "node": {
    "name": "pinsolucions",
    "type": "docker"
  },
  "services": {
    "webtense-energy": {
      "name": "webtense-energy",
      "image": "ghcr.io/webtense/webtenseenergy/webtense-energy:latest",
      "environment": {
        "NODE_ENV": "production",
        "APP_ENV": "production",
        "PORT": "3010",
        "DATABASE_URL": "__SET_IN_EASYPANEL__",
        "NEXT_PUBLIC_SITE_URL": "https://webtenseenergy.com",
        "APP_BASE_URL": "https://webtenseenergy.com",
        "ADMIN_SESSION_SECRET": "__SET_IN_EASYPANEL__",
        "ADMIN_SESSION_COOKIE_NAME": "wt_admin_session",
        "ADMIN_EMAIL": "__SET_IN_EASYPANEL__",
        "ADMIN_USERNAME": "__SET_IN_EASYPANEL__",
        "ADMIN_PASSWORD": "__SET_IN_EASYPANEL__",
        "SMTP_HOST": "__SET_IN_EASYPANEL__",
        "SMTP_PORT": "465",
        "SMTP_SECURE": "true",
        "SMTP_USER": "__SET_IN_EASYPANEL__",
        "SMTP_PASS": "__SET_IN_EASYPANEL__",
        "EMAIL_FROM": "info@webtenseenergy.com",
        "NEXT_PUBLIC_WHATSAPP": "34691521367",
        "TELEGRAM_BOT_TOKEN": "__SET_IN_EASYPANEL__",
        "TELEGRAM_CHANNEL_ID": "__SET_IN_EASYPANEL__",
        "TELEGRAM_WEBHOOK_SECRET": "__SET_IN_EASYPANEL__",
        "AMAZON_AFFILIATE_TAG": "semillasdet02-21",
        "GOOGLE_AI_API_KEY": "__SET_IN_EASYPANEL__",
        "GEMINI_MODEL": "gemini-2.0-flash",
        "GEMINI_TIMEOUT_MS": "15000",
        "ESIOS_TOKEN": "__OPTIONAL__",
        "NEWSLETTER_SENDER_NAME": "Webtense Energy",
        "NEWSLETTER_REPLY_TO": "info@webtenseenergy.com",
        "CRON_SECRET": "__SET_IN_EASYPANEL__",
        "AUTOMATION_TIMEZONE": "Europe/Madrid",
        "AUTOMATION_OFFER_LOOKBACK_HOURS": "24",
        "AUTOMATION_OFFER_MIN_DISCOUNT_PCT": "15",
        "AUTOMATION_OFFER_MAX_PER_RUN": "5",
        "AUTOMATION_NEWSLETTER_WEEKDAY": "1",
        "AUTOMATION_NEWSLETTER_MAX_POSTS": "3",
        "AUTOMATION_NEWSLETTER_MAX_OFFERS": "3",
        "AUTOMATION_LEAD_LOOKBACK_HOURS": "24"
      },
      "ports": [
        {
          "target": 3010,
          "published": 3010
        }
      ],
      "volumes": [],
      "domains": [
        {
          "host": "webtenseenergy.com",
          "port": 3010
        }
      ],
      "build": {
        "method": "dockerfile",
        "dockerfile": "Dockerfile"
      },
      "healthCheck": {
        "path": "/",
        "port": 3010
      },
      "restartPolicy": {
        "type": "on-failure"
      }
    }
  }
}
