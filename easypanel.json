{
  "$schema": "https://easypanel.io/schema.json",
  "name": "webtense-energy",
  "node": {
    "name": "pinsolucions",
    "type": "docker"
  },
  "services": {
    "webtense-energy": {
      "name": "webtense-energy",
      "image": "ghcr.io/webtense/webtenseenergy/webtense-energy:latest",
      "environment": {
        "NODE_ENV": "production",
        "DATABASE_URL": "postgresql://webtense:change_me@postgres:5432/webtenseenergy?schema=public"
      },
      "ports": [
        {
          "target": 3010,
          "published": 3010
        }
      ],
      "volumes": [],
      "domains": [
        {
          "host": "webtenseenergy.com",
          "port": 3010
        }
      ],
      "build": {
        "method": "dockerfile",
        "dockerfile": "Dockerfile"
      },
      "healthCheck": {
        "path": "/",
        "port": 3010
      },
      "restartPolicy": {
        "type": "on-failure"
      }
    }
  }
}
