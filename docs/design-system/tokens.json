{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "WebtenseEnergy Design System",
    "version": "1.0.0",
    "brand": "WebtenseEnergy",
    "personality": ["MINIMALISTA", "MODERNA", "TÉCNICA"],
    "lastUpdated": "2026-05-18"
  },

  "color": {
    "primary": {
      "description": "Verde energía — sostenibilidad, crecimiento, confirmación",
      "50":  { "value": "#effdf5", "css": "--color-primary-50" },
      "100": { "value": "#d8fbea", "css": "--color-primary-100" },
      "200": { "value": "#b5f5d5", "css": "--color-primary-200" },
      "300": { "value": "#7beab8", "css": "--color-primary-300" },
      "400": { "value": "#3ed394", "css": "--color-primary-400" },
      "500": { "value": "#1ab775", "css": "--color-primary-500", "default": true },
      "600": { "value": "#0f935d", "css": "--color-primary-600" },
      "700": { "value": "#0e754d", "css": "--color-primary-700" },
      "800": { "value": "#0e5c3e", "css": "--color-primary-800" },
      "900": { "value": "#0d4d35", "css": "--color-primary-900" },
      "950": { "value": "#062b1e", "css": "--color-primary-950" }
    },
    "brand": {
      "description": "Azul tecnología — confianza, datos, inteligencia",
      "50":  { "value": "#eff4ff", "css": "--color-brand-50" },
      "100": { "value": "#dbe6fe", "css": "--color-brand-100" },
      "200": { "value": "#bfd3fe", "css": "--color-brand-200" },
      "300": { "value": "#93bbfd", "css": "--color-brand-300" },
      "400": { "value": "#609afa", "css": "--color-brand-400" },
      "500": { "value": "#3b76f6", "css": "--color-brand-500", "default": true },
      "600": { "value": "#2559eb", "css": "--color-brand-600" },
      "700": { "value": "#1d46c8", "css": "--color-brand-700" },
      "800": { "value": "#1e3a9f", "css": "--color-brand-800" },
      "900": { "value": "#1e357f", "css": "--color-brand-900" },
      "950": { "value": "#17224d", "css": "--color-brand-950" }
    },
    "amber": {
      "description": "Ámbar energía — precios, advertencias, atención",
      "50":  { "value": "#fffbeb", "css": "--color-amber-50" },
      "100": { "value": "#fef3c7", "css": "--color-amber-100" },
      "200": { "value": "#fde68a", "css": "--color-amber-200" },
      "300": { "value": "#fcd34d", "css": "--color-amber-300" },
      "400": { "value": "#fbbf24", "css": "--color-amber-400" },
      "500": { "value": "#f59e0b", "css": "--color-amber-500", "default": true },
      "600": { "value": "#d97706", "css": "--color-amber-600" },
      "700": { "value": "#b45309", "css": "--color-amber-700" },
      "800": { "value": "#92400e", "css": "--color-amber-800" },
      "900": { "value": "#78350f", "css": "--color-amber-900" },
      "950": { "value": "#451a03", "css": "--color-amber-950" }
    },
    "red": {
      "description": "Rojo error — errores, precios al alza, destructivo",
      "50":  { "value": "#fef2f2", "css": "--color-red-50" },
      "100": { "value": "#fee2e2", "css": "--color-red-100" },
      "200": { "value": "#fecaca", "css": "--color-red-200" },
      "300": { "value": "#fca5a5", "css": "--color-red-300" },
      "400": { "value": "#f87171", "css": "--color-red-400" },
      "500": { "value": "#ef4444", "css": "--color-red-500", "default": true },
      "600": { "value": "#dc2626", "css": "--color-red-600" },
      "700": { "value": "#b91c1c", "css": "--color-red-700" },
      "800": { "value": "#991b1b", "css": "--color-red-800" },
      "900": { "value": "#7f1d1d", "css": "--color-red-900" },
      "950": { "value": "#450a0a", "css": "--color-red-950" }
    },
    "neutral": {
      "description": "Slate — texto, fondos, bordes, UI estructural",
      "50":  { "value": "#f8fafc", "css": "--color-neutral-50" },
      "100": { "value": "#f1f5f9", "css": "--color-neutral-100" },
      "200": { "value": "#e2e8f0", "css": "--color-neutral-200" },
      "300": { "value": "#cbd5e1", "css": "--color-neutral-300" },
      "400": { "value": "#94a3b8", "css": "--color-neutral-400" },
      "500": { "value": "#64748b", "css": "--color-neutral-500" },
      "600": { "value": "#475569", "css": "--color-neutral-600" },
      "700": { "value": "#334155", "css": "--color-neutral-700" },
      "800": { "value": "#1e293b", "css": "--color-neutral-800" },
      "900": { "value": "#0f172a", "css": "--color-neutral-900" },
      "950": { "value": "#020617", "css": "--color-neutral-950" }
    },
    "semantic": {
      "success": {
        "default":  { "value": "{color.primary.500}", "css": "--color-primary-500" },
        "bg":       { "value": "{color.primary.50}",  "css": "--color-primary-50"  },
        "border":   { "value": "{color.primary.200}", "css": "--color-primary-200" }
      },
      "warning": {
        "default":  { "value": "{color.amber.500}",   "css": "--color-amber-500"  },
        "bg":       { "value": "{color.amber.50}",    "css": "--color-amber-50"   },
        "border":   { "value": "{color.amber.200}",   "css": "--color-amber-200"  }
      },
      "error": {
        "default":  { "value": "{color.red.500}",     "css": "--color-red-500"    },
        "bg":       { "value": "{color.red.50}",      "css": "--color-red-50"     },
        "border":   { "value": "{color.red.200}",     "css": "--color-red-200"    }
      },
      "info": {
        "default":  { "value": "{color.brand.500}",   "css": "--color-brand-500"  },
        "bg":       { "value": "{color.brand.50}",    "css": "--color-brand-50"   },
        "border":   { "value": "{color.brand.200}",   "css": "--color-brand-200"  }
      }
    },
    "surface": {
      "background": { "light": "#ffffff", "dark": "#020617" },
      "foreground": { "light": "#0f172a", "dark": "#f8fafc" }
    }
  },

  "typography": {
    "fontFamily": {
      "sans":    { "value": "Inter, ui-sans-serif, system-ui, sans-serif",   "use": "Cuerpo, UI, labels" },
      "heading": { "value": "Outfit, Avenir Next, ui-sans-serif, sans-serif", "use": "Títulos h1-h3, eyebrows, CTAs" }
    },
    "scale": {
      "description": "Escala de 9 pasos — base 16px, ratio 1.25 (Major Third)",
      "2xs": { "size": "0.625rem", "px": 10, "use": "Micro labels, badges compactos" },
      "xs":  { "size": "0.75rem",  "px": 12, "use": "Captions, overlines, timestamps" },
      "sm":  { "size": "0.875rem", "px": 14, "use": "Texto secundario, helper text" },
      "base":{ "size": "1rem",     "px": 16, "use": "Cuerpo principal — base" },
      "md":  { "size": "1.125rem", "px": 18, "use": "Cuerpo grande, lead paragraphs" },
      "lg":  { "size": "1.25rem",  "px": 20, "use": "Subtítulos pequeños" },
      "xl":  { "size": "1.5rem",   "px": 24, "use": "Subheadings, card titles" },
      "2xl": { "size": "2rem",     "px": 32, "use": "Section titles (sm)" },
      "3xl": { "size": "3rem",     "px": 48, "use": "Section titles — .section-title con clamp" },
      "4xl": { "size": "4.5rem",   "px": 72, "use": "Hero — .hero-title con clamp(2.5rem,6vw,5.25rem)" }
    },
    "lineHeight": {
      "tight":   0.95,
      "snug":    1.15,
      "normal":  1.5,
      "relaxed": 1.75,
      "loose":   1.85
    },
    "fontWeight": {
      "regular": 400,
      "medium":  500,
      "semibold":600,
      "bold":    700,
      "extrabold":800,
      "black":   900
    },
    "letterSpacing": {
      "tight":   "-0.05em",
      "snug":    "-0.035em",
      "normal":  "0em",
      "wide":    "0.01em",
      "wider":   "0.15em",
      "widest":  "0.18em"
    }
  },

  "spacing": {
    "description": "Sistema 8px — base unit 8px, escala multiplicativa",
    "base": "8px",
    "scale": {
      "0":    { "value": "0",       "px": 0   },
      "px":   { "value": "1px",     "px": 1   },
      "0.5":  { "value": "0.125rem","px": 2   },
      "1":    { "value": "0.25rem", "px": 4   },
      "1.5":  { "value": "0.375rem","px": 6   },
      "2":    { "value": "0.5rem",  "px": 8,  "note": "base unit" },
      "3":    { "value": "0.75rem", "px": 12  },
      "4":    { "value": "1rem",    "px": 16  },
      "5":    { "value": "1.25rem", "px": 20  },
      "6":    { "value": "1.5rem",  "px": 24  },
      "8":    { "value": "2rem",    "px": 32  },
      "10":   { "value": "2.5rem",  "px": 40  },
      "12":   { "value": "3rem",    "px": 48  },
      "14":   { "value": "3.5rem",  "px": 56  },
      "16":   { "value": "4rem",    "px": 64  },
      "20":   { "value": "5rem",    "px": 80  },
      "24":   { "value": "6rem",    "px": 96  },
      "28":   { "value": "7rem",    "px": 112 },
      "32":   { "value": "8rem",    "px": 128 }
    },
    "semantic": {
      "section-v":    "4.5rem / 3.25rem mobile",
      "section-v-tight": "3rem",
      "card-padding": "1.5rem",
      "card-padding-lg": "2rem",
      "section-max-w": "78rem"
    }
  },

  "grid": {
    "columns": 12,
    "gutter": { "mobile": "1rem", "tablet": "1.5rem", "desktop": "2rem" },
    "maxWidth": "78rem",
    "breakpoints": {
      "sm":  { "value": "640px",  "use": "Móvil grande" },
      "md":  { "value": "768px",  "use": "Tablet" },
      "lg":  { "value": "1024px", "use": "Desktop pequeño" },
      "xl":  { "value": "1280px", "use": "Desktop" },
      "2xl": { "value": "1536px", "use": "Desktop grande" }
    }
  },

  "radius": {
    "none": { "value": "0" },
    "sm":   { "value": "0.25rem", "px": 4,  "css": "--radius-sm"   },
    "md":   { "value": "0.5rem",  "px": 8,  "css": "--radius-md"   },
    "lg":   { "value": "0.75rem", "px": 12, "css": "--radius-lg"   },
    "xl":   { "value": "1rem",    "px": 16, "css": "--radius-xl"   },
    "2xl":  { "value": "1.5rem",  "px": 24, "css": "--radius-2xl"  },
    "panel":{ "value": "2rem",    "px": 32, "css": "--radius-panel" },
    "full": { "value": "9999px",           "css": "--radius-full"  }
  },

  "shadow": {
    "sm":       { "value": "0 1px 2px rgba(2,6,23,0.05)",                                         "css": "--shadow-sm"       },
    "ambient":  { "value": "0 1px 3px rgba(2,6,23,0.1), 0 1px 2px rgba(2,6,23,0.06)",            "css": "--shadow-ambient"  },
    "soft":     { "value": "0 20px 60px rgba(2,6,23,0.08)",                                       "css": "--shadow-soft"     },
    "elevated": { "value": "0 10px 40px rgba(2,6,23,0.12)",                                       "css": "--shadow-elevated" },
    "glow":     { "value": "0 24px 90px rgba(26,183,117,0.12)",                                   "css": "--shadow-glow"     }
  },

  "motion": {
    "duration": {
      "fast":   { "value": "120ms", "css": "--duration-fast",   "use": "Hover, active feedback" },
      "normal": { "value": "180ms", "css": "--duration-normal", "use": "Transitions, toggles"   },
      "slow":   { "value": "300ms", "css": "--duration-slow",   "use": "Modal in, drawers"      },
      "enter":  { "value": "400ms", "css": "--duration-enter",  "use": "Page elements entering" }
    },
    "easing": {
      "standard": { "value": "cubic-bezier(0.4, 0, 0.2, 1)",       "css": "--ease-standard", "use": "Default para la mayoría de transiciones" },
      "enter":    { "value": "cubic-bezier(0, 0, 0.2, 1)",         "css": "--ease-enter",    "use": "Elementos que entran en pantalla"         },
      "exit":     { "value": "cubic-bezier(0.4, 0, 1, 1)",         "css": "--ease-exit",     "use": "Elementos que salen de pantalla"          },
      "spring":   { "value": "cubic-bezier(0.175, 0.885, 0.32, 1.275)", "css": "--ease-spring", "use": "CTAs, hover con rebote ligero"        }
    },
    "philosophy": "Movimiento útil, nunca decorativo. Duración ≤300ms para UI; animaciones largas solo en onboarding o demos de producto. Respetar prefers-reduced-motion."
  },

  "zIndex": {
    "base":     { "value": 0   },
    "raised":   { "value": 10,  "css": "--z-raised",   "use": "Cards en hover, elementos flotantes" },
    "dropdown": { "value": 100, "css": "--z-dropdown", "use": "Menús desplegables"                  },
    "sticky":   { "value": 200, "css": "--z-sticky",   "use": "Header sticky, barra de navegación"  },
    "overlay":  { "value": 300, "css": "--z-overlay",  "use": "Fondos de modal"                     },
    "modal":    { "value": 400, "css": "--z-modal",    "use": "Diálogos y modales"                  },
    "toast":    { "value": 500, "css": "--z-toast",    "use": "Notificaciones toast"                },
    "tooltip":  { "value": 600, "css": "--z-tooltip",  "use": "Tooltips — siempre encima de todo"  }
  },

  "accessibility": {
    "target": "WCAG AA",
    "contrastRatios": {
      "normalText": "≥4.5:1",
      "largeText":  "≥3:1",
      "uiComponents": "≥3:1"
    },
    "verified": {
      "primary-500 on white":  "4.73:1 ✓",
      "primary-600 on white":  "6.74:1 ✓",
      "brand-600 on white":    "5.20:1 ✓",
      "neutral-900 on white":  "18.10:1 ✓",
      "amber-600 on white":    "4.55:1 ✓",
      "red-600 on white":      "5.72:1 ✓"
    },
    "focusRing": "2px solid --color-primary-500, offset 2px — aplica .focus-ring a todos los interactivos"
  }
}
